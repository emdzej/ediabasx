{
  "name": "@emdzej/ediabasx-server",
  "version": "0.7.0",
  "description": "EdiabasX JSON-RPC server — run diagnostic jobs remotely over TCP or WebSocket.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@emdzej/bimmerz-logger": "^0.1.2",
    "@emdzej/ediabasx-best-parser": "workspace:*",
    "@emdzej/ediabasx-core": "workspace:*",
    "@emdzej/ediabasx-ediabas": "workspace:*",
    "@emdzej/ediabasx-host-config": "workspace:*",
    "@emdzej/ediabasx-interface-base": "workspace:*",
    "@emdzej/ediabasx-interfaces": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/ws": "^8.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/emdzej/ediabasx.git"
  }
}
