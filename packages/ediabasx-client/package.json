{
  "name": "@emdzej/ediabasx-client",
  "version": "0.8.0",
  "description": "EdiabasX client — remote (JSON-RPC) and embedded (in-process) implementations of IEdiabas.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@emdzej/ediabasx-core": "workspace:*",
    "@emdzej/ediabasx-ediabas": "workspace:*",
    "@emdzej/ediabasx-interface-base": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/emdzej/ediabasx.git"
  }
}
